{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    /* A composite project has to emit, so send the output somewhere harmless.
       It used to land next to the source as vite.config.js, and Vite loads a
       .js config in preference to the .ts one — so edits to vite.config.ts
       were silently ignored in favour of a stale compiled copy. */
    "outDir": "./node_modules/.tmp/node-build"
  },
  "include": ["vite.config.ts"]
}
